{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  // Repo-owned wrapper. Extends the canonical strict base synced from
  // davidvornholt/standards. Add project-specific overrides here; never edit
  // biome.base.jsonc locally.
  "extends": ["./biome.base.jsonc"],
  "files": {
    // Claude agent worktrees are full checkouts with their own root
    // biome.jsonc; nested biome.json(c) files are scanner-priority special
    // files, so only force-ignore (`!!`) guarantees they are never discovered
    // as nested roots.
    // routeTree.gen.ts is generated by TanStack Router on every dev and build
    // run, and packages/db/drizzle is drizzle-kit's generated migration
    // output.
    "includes": [
      "**",
      "!!.claude/worktrees",
      "!apps/web/src/routeTree.gen.ts",
      "!packages/db/drizzle"
    ]
  },
  "overrides": [
    {
      // Designated server environment boundary: the one application file
      // allowed to read process.env. Everything else imports from it.
      "includes": ["apps/web/src/shared/env/server.ts"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "off" },
          "style": { "noProcessEnv": "off" }
        }
      }
    },
    {
      // Server-only Nitro runtime plugin: Nitro loads it through its default
      // export, and it ends the server process.
      "includes": ["apps/web/src/shared/runtime/exit-on-close.ts"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "off" },
          "style": { "noDefaultExport": "off" }
        }
      }
    },
    {
      // The administrator's command line, the build scripts, and the
      // accessibility suite's server run only under Bun, never in a browser,
      // which is what noNodejsModules protects. The `Bun` global comes from
      // that runtime.
      "includes": [
        "apps/web/scripts/**",
        "apps/web/a11y/serve.ts",
        "packages/db/src/migrate-cli.ts"
      ],
      "javascript": { "globals": ["Bun"] },
      "linter": {
        "rules": { "correctness": { "noNodejsModules": "off" } }
      }
    },
    {
      // The accessibility suite's server hands its own environment, plus the
      // test database and port, to the app it starts.
      "includes": ["apps/web/a11y/serve.ts"],
      "linter": { "rules": { "style": { "noProcessEnv": "off" } } }
    },
    {
      // Tokens are hashed on the server only, which runs under Bun, so its
      // built-in hasher is the one to use.
      "includes": ["apps/web/src/shared/auth/tokens.ts"],
      "javascript": { "globals": ["Bun"] }
    },
    {
      // These framework boundaries require default exports as part of their
      // file-based contracts (Vite, Playwright, and Drizzle Kit).
      "includes": [
        "apps/web/vite.config.ts",
        "apps/web/playwright.config.ts",
        "packages/db/drizzle.config.ts"
      ],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      // __root.tsx links styles.css by URL, so Biome connects the components
      // it renders to the stylesheet, but their classes are Tailwind
      // utilities generated at build time, which Biome cannot resolve.
      "includes": ["apps/web/src/**/*.tsx"],
      "linter": {
        "rules": { "nursery": { "noUndeclaredClasses": "off" } }
      }
    },
    {
      // The stylesheet's component classes are applied through class
      // constants and template strings as often as through a lone className
      // literal, so noUnusedClasses reports live selectors as dead.
      "includes": ["apps/web/src/styles.css", "apps/web/src/styles/**"],
      "linter": {
        "rules": { "nursery": { "noUnusedClasses": "off" } }
      }
    }
  ]
}
