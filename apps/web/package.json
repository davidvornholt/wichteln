{
  "name": "@wichteln/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "vite build && bun build --target=bun --outdir=.output/admin scripts/admin.ts",
    "start": "bun .output/server/index.mjs",
    "admin": "bun .output/admin/admin.js",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "test:a11y": "playwright install chromium && playwright test",
    "icons:render": "bun scripts/render-app-icons.ts"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "@wichteln/db": "workspace:*",
    "effect": "^4.1.4",
    "lucide-react": "^1.74.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@davidvornholt/a11y-testing": "workspace:*",
    "@davidvornholt/typescript-config": "workspace:*",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "nitro": "^3.0.260903-beta",
    "typescript": "7.0.2",
    "vite": "^8.3.8"
  }
